# Weihnachtskisten-Schneefall
# Diese Effekte werden vom Server um die Kiste herum erzeugt.
# Die Schneeflocken sind echte Minecraft-Partikel und gehören NICHT zum 3D-Modell.

command /weihnachtskiste-schnee <text>:
    permission: maumod.weihnachtskiste.schnee
    permission message: &cDazu hast du keine Berechtigung.
    trigger:
        if arg-1 is "setzen":
            set {maumod::weihnachtskiste::schnee::zentrum} to location of player
            send "&aSchneefall für die Weihnachtskiste wurde an deiner Position eingerichtet." to player
            send "&7Die Position bleibt auch nach einem Serverneustart gespeichert." to player
        else if arg-1 is "entfernen":
            delete {maumod::weihnachtskiste::schnee::zentrum}
            send "&eDer Schneefall um die Weihnachtskiste wurde entfernt." to player
        else:
            send "&cVerwendung: /weihnachtskiste-schnee setzen oder /weihnachtskiste-schnee entfernen" to player

# Sanfter, dauerhafter Schneefall in einem Bereich rund um den gespeicherten Kistenstandort.
every 5 ticks:
    if {maumod::weihnachtskiste::schnee::zentrum} is set:
        set {_zentrum} to {maumod::weihnachtskiste::schnee::zentrum}
        set {_x} to x-coordinate of {_zentrum}
        set {_y} to y-coordinate of {_zentrum} + 2.2
        set {_z} to z-coordinate of {_zentrum}
        execute console command "particle minecraft:snowflake %{_x}% %{_y}% %{_z}% 2.2 2.5 2.2 0.015 5 force"
